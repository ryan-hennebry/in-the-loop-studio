---
import Base from "../layouts/Base.astro";
import {
  HEADLINE,
  HOME_CTA_HREF,
  HOME_CTA_LABEL,
  PROPERTIES,
  SITE_TITLE,
} from "../config.ts";
---
<Base
  title={SITE_TITLE}
  description={HEADLINE}
  path="/"
>
  <h1 class="headline">{HEADLINE}</h1>

  <section class="programme" aria-label="The system">
    <ul class="properties">
      {PROPERTIES.map((property) => (
        <li class="property">
          <div class="property__row">
            <span class="property__name">{property.name}</span>
            <span class="property__description">{property.description}</span>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <a class="primary-link" href={HOME_CTA_HREF}>
    <span class="primary-link__label">{HOME_CTA_LABEL}</span>
  </a>
</Base>
