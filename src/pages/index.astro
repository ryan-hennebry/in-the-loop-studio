---
// The whole surface: the headline, the links out, one call to action, and the
// capture that the layout carries. No paragraph under the headline, no
// services list, no about section, no work page. The headline carries it.
import Base from "../layouts/Base.astro";
import { CTA_HREF, CTA_LABEL, HEADLINE_LINES, LINKS, SITE_TITLE } from "../config.ts";

const links = [
  { label: "Startup Skills", href: LINKS.skills },
  { label: "The Feed", href: LINKS.feed },
  { label: "The newsletter", href: LINKS.newsletter },
];
---
<Base
  title={SITE_TITLE}
  description={HEADLINE_LINES.join(" ")}
  path="/"
>
  <h1 class="headline">
    {HEADLINE_LINES.map((line) => <span>{line}</span>)}
  </h1>

  <ul class="links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>

  <p>
    <a class="cta" href={CTA_HREF}>
      <span class="bracket" aria-hidden="true">[</span> {CTA_LABEL} <span class="bracket" aria-hidden="true">]</span>
    </a>
  </p>
</Base>
